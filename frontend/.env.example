# Optional. Copy to .env.local to override.
# Absolute API URL if the API is NOT served from the same origin (default: /api via proxy/nginx)
# VITE_API_URL=http://localhost:8080/api

# Show the "Demo quick login" buttons and the header role switcher (seeded accounts).
# Set to false for real deployments (and run the backend with CEMS_SEED=false).
VITE_DEMO_MODE=true
# VITE_DEMO_PASSWORD=cems@123
